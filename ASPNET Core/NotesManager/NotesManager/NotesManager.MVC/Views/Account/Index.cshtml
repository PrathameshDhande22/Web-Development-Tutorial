@*Specifing the Strongly typed view using model directive*@
@model AccountViewModel

@*Displaying the Tempdata message*@
@if (TempData.ContainsKey("Message"))
{
    <div role="alert" class="alert alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>@TempData["Message"]</span>
    </div>
}


<div class="flex flex-col gap-2">
    <span>
        Email: @Model.Email <!-- Accessing the Model Property using Model Property-->
    </span>
    <span>
        Name: @Model.Name
    </span>
    <span>
        Member Since : @Model.MemberSince.ToShortDateString()  <!-- Can even using the Method directly -->
    </span>
</div>