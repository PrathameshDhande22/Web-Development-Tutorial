@model List<NoteDTO>

@*These is the view component view*@
<div class="mt-3 w-full space-y-2" id="pinned">
    <!--Pinned Notes-->
    @foreach (NoteDTO note in Model)
    {
        <a asp-route="NoteDetails" asp-route-id="@note.Id" class="block w-full rounded-md border border-gray-200 p-3 text-sm hover:border-gray-500 dark:border-gray-700 dark:hover:border-gray-300">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-gray-400" viewBox="0 0 16 16"><path fill="currentColor" d="M3 0h10v1c0 1.173-.294 2.075-.606 2.697a5 5 0 0 1-.394.656v2.175A6 6 0 0 1 14 11v1H9v3a1 1 0 1 1-2 0v-3H2v-1c0-1.778.774-3.375 2-4.472V4.353a5 5 0 0 1-.394-.656C3.294 3.075 3 2.173 3 1zm2.11 2c.076.332.183.6.284.803a2.7 2.7 0 0 0 .316.492l.006.006l.284.285v3.913l-.4.3A4 4 0 0 0 4.127 10h7.748A4 4 0 0 0 10.4 7.8l-.4-.3V3.585l.284-.284l.006-.007a2.7 2.7 0 0 0 .315-.492c.102-.204.209-.47.285-.803z" /></svg>
                <span class="inline-block font-semibold text-black dark:text-gray-100">@note.Title</span>
            </div>
            <div class="mt-2 text-gray-400">@note.Description</div>
        </a>
    }
    <!--No Pin notes-->
    @if (Model.Count <= 0)
    {
        <div class="text-sm text-gray-400">Pin important notes from the notes list to keep them there</div>
    }
</div>