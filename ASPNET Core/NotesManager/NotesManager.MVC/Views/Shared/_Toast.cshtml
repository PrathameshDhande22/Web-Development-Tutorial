<div class="toast toast-end z-9999">
    @if (TempData.TryGetValue("Success", out object value))
    {
        <div class="alert z-9999" id="toast-message">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-green-500" viewBox="0 0 16 16"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m2.75 8.75l3.5 3.5l7-7.5" /></svg>
            <span>@Convert.ToString(value)</span>
        </div>
    }
    else if (TempData.TryGetValue("Info", out value))
    {
        <div class="alert z-9999" id="toast-message">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-yellow-600" viewBox="0 0 20 20" fill="currentColor"><g fill="currentColor"><path fill-rule="evenodd" d="M10 7a2 2 0 0 1 2 2v7a2 2 0 1 1-4 0V9a2 2 0 0 1 2-2Z" clip-rule="evenodd" /><path d="M12 4a2 2 0 1 1-4 0a2 2 0 0 1 4 0Z" /></g></svg>
            <span>@Convert.ToString(value)</span>
        </div>
    }
    else if (TempData.TryGetValue("Error", out value))
    {
        <div class="alert z-9999" id="toast-message">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-red-600" viewBox="0 0 15 15"><path fill="curentColor" d="M3.64 2.27L7.5 6.13l3.84-3.84A.92.92 0 0 1 12 2a1 1 0 0 1 1 1a.9.9 0 0 1-.27.66L8.84 7.5l3.89 3.89A.9.9 0 0 1 13 12a1 1 0 0 1-1 1a.92.92 0 0 1-.69-.27L7.5 8.87l-3.85 3.85A.92.92 0 0 1 3 13a1 1 0 0 1-1-1a.9.9 0 0 1 .27-.66L6.16 7.5L2.27 3.61A.9.9 0 0 1 2 3a1 1 0 0 1 1-1c.24.003.47.1.64.27Z" /></svg>
            <span>@Convert.ToString(value)</span>
        </div>
    }

</div>