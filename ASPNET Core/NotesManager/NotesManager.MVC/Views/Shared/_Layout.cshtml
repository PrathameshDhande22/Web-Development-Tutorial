<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NoteWell</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NotesManager.MVC.styles.css" asp-append-version="true" />

</head>

<body>
    <!--Header Creating as the Layout-->
    <header class="sticky top-0 border-b z-30 border-gray-300/50 ">
        <div
            class="navbar mx-auto max-w-7xl flex w-full flex-row items-center justify-between gap-10 bg-base-100 px-4 md:px-8">
            <!--Left side Navigation-->
            <div class="flex flex-row items-center justify-between gap-2">
                <!--Navbar logo-->
                <a class="text-lg font-bold tracking-tight flex flex-row gap-1 items-center">
                    <img src="/images/logo.png" class="w-12" loading="lazy" alt="Logo of Notewell" />
                    <span>Notewell</span>
                </a>
                <!--Navbar menu-->
                <nav class="ml-10 hidden sm:block">
                    <ul class="flex flex-row gap-7 text-gray-500 text-sm">
                        <li>Features</li>
                        <li>Views</li>
                        <li>Privacy</li>
                    </ul>
                </nav>
            </div>
            <!--Right Side Navigation-->
            <div class="flex flex-row items-center gap-1">
                <!--Dark theme toggle-->
                <button id="theme-toggle" class="btn text-black btn-ghost btn-sm btn-square text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="currentColor"
                              d="M21.64 13a1 1 0 0 0-1.05-.14a8.05 8.05 0 0 1-3.37.73a8.15 8.15 0 0 1-8.14-8.1a8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69a1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14a9.79 9.79 0 0 0 2.1-.22a8.11 8.11 0 0 1-7.18 4.32Z" />
                    </svg>
                </button>
                <a href="/Account/Login" class="btn btn-ghost btn-sm">Sign In</a>
                <a href="/Account/Register" class="btn btn-primary btn-sm shadow-none rounded-md">Get Started</a>
            </div>

        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false);
    <!--footer-->
    <footer class=" border-t z-30 border-gray-300/50 px-5 text-gray-500">
        <ul class="flex mx-auto max-w-7xl flex-row items-center gap-10 py-4 text-sm">
            <li>
                Made by <span class="font-bold">Prathamesh Dhande</span>
            </li>
            <li>
                <a href="https://github.com/PrathameshDhande" class="link link-hover flex flex-row items-center gap-2">
                    <!--Github Logo-->
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24">
                        <path fill="none" stroke="#000000" stroke-linecap="round" stroke-linejoin="round"
                              stroke-width="2"
                              d="M9 22v-3q0-2 1-3A7 6.5 0 0 1 5 5Q4 3 5 1q3 0 4 2q3.5-1 7 0q1-2 4-2q1 2 0 4a7 6.5 0 0 1-5 11q1 1 1 3v3m-7-3c-4 1-4-2-7-3" />
                    </svg>
                    <span>
                        Source Code on Github
                    </span>
                </a>
            </li>
        </ul>
    </footer>
</body>

</html>
