@model NoteDTO
@using Humanizer

@{
    ViewData["Title"] = Model.Title.ToLower();
    NoteStatus[] statuses = Enum.GetValues<NoteStatus>();
}

@functions {
    public string ConvertToHuman(long value)
    {
        return value.Bytes().Humanize("0.00");
    }
}

<div class="mx-auto max-w-7xl flex-1 px-4 py-8 md:px-8 md:py-10">
    <div>
        <div class="flex flex-row items-center justify-between">
            <!--Back Button-->
            <a asp-route="NotesList" asp-route-LoadPrevFilter="true" class="btn btn-sm btn-ghost space-x-1.5 self-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 dark:text-gray-300" viewBox="0 0 1024 1024">
                    <path fill="currentColor" d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" />
                    <path fill="currentColor" d="m237.248 512l265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" />
                </svg>
                <span class="hidden sm:inline">
                    Notes
                </span>
            </a>
            <!--Notes Action Buttons-->
            <div class="flex flex-row items-center gap-1 sm:gap-3">
                <!--Status Drop down-->
                <select class="select dark:text-gray-300" id="status-selected" name="note-status" data-noteid="@Model.Id">
                    @foreach (NoteStatus status in statuses)
                    {
                        var currentStatusMapping = CategoryConstants.StatusMapping[status];
                        <option value="@status" selected="@(Model.Status == status)" class="space-x-1.5 checked:bg-black checked:text-white">
                            <span class="size-2 @currentStatusMapping.color rounded-full"></span>
                            <span>@currentStatusMapping.label</span>
                        </option>
                    }
                </select>
                <!--Pin Note Button-->
                <button class="btn btn-sm btn-ghost dark:text-gray-300 @(Model.Pinned ? "btn-active" : "")" type="button" id="pin-note" data-noteId="@Model.Id">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 16 16"><path fill="currentColor" d="M3 0h10v1c0 1.173-.294 2.075-.606 2.697a5 5 0 0 1-.394.656v2.175A6 6 0 0 1 14 11v1H9v3a1 1 0 1 1-2 0v-3H2v-1c0-1.778.774-3.375 2-4.472V4.353a5 5 0 0 1-.394-.656C3.294 3.075 3 2.173 3 1zm2.11 2c.076.332.183.6.284.803a2.7 2.7 0 0 0 .316.492l.006.006l.284.285v3.913l-.4.3A4 4 0 0 0 4.127 10h7.748A4 4 0 0 0 10.4 7.8l-.4-.3V3.585l.284-.284l.006-.007a2.7 2.7 0 0 0 .315-.492c.102-.204.209-.47.285-.803z" /></svg>
                </button>
                <!--Note History Button-->
                <a asp-action="History" asp-controller="Notes" asp-route-id="@Model.Id" class="btn btn-sm btn-ghost space-x-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3M3.223 14A9 9 0 1 0 12 3a9 9 0 0 0-8.294 5.5M7 9H3V5" /></svg>
                    <span class="hidden sm:inline">History</span>
                </a>
                <!--Edit note button-->
                <a asp-action="Edit" asp-controller="Notes" asp-route-id="@Model.Id" class="btn btn-sm btn-primary space-x-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 14 14"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M5 12.24L.5 13.5L1.76 9L10 .8a1 1 0 0 1 1.43 0l1.77 1.78a1.001 1.001 0 0 1 0 1.42z" /></svg>
                    <span class="hidden sm:inline">Edit</span>
                </a>
                <!--Dropdown content-->
                <div class="dropdown dropdown-end">
                    <div tabindex="0" role="button" class="btn btn-ghost rounded-field">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 dark:text-gray-300" viewBox="0 0 16 16"><path fill="currentColor" d="M3 9.5a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3z" /></svg>
                    </div>
                    <ul tabindex="-1"
                        class="menu dropdown-content rounded-box z-1 mt-4 w-52 bg-base-100 p-2 shadow-sm">
                        <li>
                            <!--Export to MD-->
                            <a id="export-md" class="dark:text-gray-300" asp-action="Export" asp-controller="Notes" asp-route-id="@Model.Id">
                                <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg>Download as MD file
                            </a>
                        </li>
                        <li>
                            <!--Delete Note-->
                            <button id="delete-note" class="text-error">
                                <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>Delete note
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <!--Note Content-->
        <div class="mt-6 grid gap-10 lg:grid-cols-3">
            <!--Note-->
            <div class="min-w-0 lg:col-span-2">
                <!--Title-->
                <h2 class="text-3xl font-semibold" id="note-title">@Model.Title</h2>
                <div class="mt-3 flex flex-wrap gap-5">
                    <!--Status-->
                    <status-badge status="@Model.Status" />
                    <!--Category-->
                    <category category-name="@Model.Category.Name" color="@Model.Category.Color" />
                    <!--Updated Time Ago-->
                    <span class="text-stone-500">·</span>
                    <span>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span class="text-sm text-stone-400">
                                Updated
                            </span>
                            <time-ago date="Model.UpdatedAt.Value.DateTime" />
                        }
                        else
                        {
                            <span class="text-sm text-stone-400">
                                Created
                            </span>
                            <time-ago date="Model.CreatedAt.DateTime" />
                        }
                    </span>
                </div>
                <!--Content-->
                <div class="markdown-content mt-6 border-t border-gray-300 pt-6 dark:border-gray-700">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        @Html.Raw(MarkdownRenderer.ConvertToHTML(Model.Description))
                    }
                    else
                    {
                        <span class="text-xl text-gray-400 italic">Nothing written yet</span>
                    }
                </div>
            </div>
            <!--Note Details-->
            <aside class="border-t border-gray-300 pt-6 lg:border-t-0 lg:pt-0 lg:pl-8">
                <section>
                    <h3 class="text-sm font-medium tracking-wide text-gray-400 uppercase">Details</h3>
                    <dl class="mt-4 space-y-4 text-sm">
                        <div class="grid grid-cols-3 items-center gap-3">
                            <dt class="text-gray-500 dark:text-gray-400">Status</dt>
                            <dd class="col-span-2">
                                <status-badge status="@Model.Status" />
                            </dd>
                        </div>
                        <div class="grid grid-cols-3 items-center gap-3">
                            <dt class="text-gray-500 dark:text-gray-400">Category</dt>
                            <category category-name="@Model.Category.Name" color="@Model.Category.Color" class="flex items-center gap-1" />
                        </div>
                        <div class="grid grid-cols-3 items-start gap-3">
                            <dt class="text-gray-500 dark:text-gray-400">Created</dt>
                            <dd class="col-span-2">@Model.CreatedAt.LocalDateTime.ToString("MMM dd, yyyy, hh:mm tt")</dd>
                        </div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="grid grid-cols-3 items-start gap-3">
                                <dt class="text-gray-500 dark:text-gray-400">Updated</dt>
                                <dd class="col-span-2">@Model.UpdatedAt.Value.LocalDateTime.ToString("MMM dd, yyyy, hh:mm tt")</dd>
                            </div>
                        }
                    </dl>
                </section>
                <!--Note Attachments-->
                <section class="mt-8 space-y-3">
                    <div class="flex justify-between">
                        <h3 class="text-sm font-medium tracking-wide text-gray-400 uppercase">Attachments</h3>
                        <span id="attachment-count" class="text-sm text-gray-400 @(Model.Attachments.Count == 0 ? "hidden" : "")">@Model.Attachments.Count</span>
                    </div>
                    <div class="mt-3 w-full">
                        <!--Note Attachments List-->
                        <ul id="attachment-list" class="flex flex-col gap-1">
                            @foreach (NoteAttachmentDTO attachmentDTO in Model.Attachments)
                            {
                                <li class="rounded-box attachment flex w-full cursor-pointer items-center gap-3 p-2 transition-colors hover:bg-base-200" data-attachment-id="@attachmentDTO.Id" data-ispdf="@(attachmentDTO.AttachMentType == NoteAttachmentType.PDF)">
                                    <!--File Type Icon-->
                                    @if (attachmentDTO.AttachMentType == NoteAttachmentType.PDF)
                                    {
                                        <span class="rounded-field grid size-9 shrink-0 place-items-center bg-gray-100 text-gray-600 dark:bg-red-500/15 dark:text-gray-400" data-icon="pdf">
                                            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="rounded-field grid size-9 shrink-0 place-items-center bg-gray-100 text-gray-600 dark:bg-blue-500/15 dark:text-gray-400" data-icon="image">
                                            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
                                        </span>
                                    }
                                    <!--File Details-->
                                    <div class="flex min-w-0 flex-1 flex-col">
                                        <span data-field="name" class="truncate text-sm font-medium text-gray-800 dark:text-gray-200" title="@attachmentDTO.FileName">@attachmentDTO.FileName</span>
                                        <span class="truncate text-xs text-gray-400">
                                            @ConvertToHuman(attachmentDTO.Size) ·
                                            <time-ago class="text-xs" date="attachmentDTO.CreatedAt.DateTime" />
                                        </span>
                                    </div>
                                    <!--Attachment Actions-->
                                    <div class="flex shrink-0 gap-1 text-gray-400">
                                        <a type="button" asp-action="DownloadAttachMent" asp-controller="Notes" asp-route-id="@attachmentDTO.Id" class="btn btn-ghost btn-xs btn-square" aria-label="Download @attachmentDTO.FileName" title="Download">
                                            <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg>
                                        </a>
                                        <button type="button" data-action="delete" class="btn btn-ghost btn-xs btn-square hover:text-error" aria-label="Delete @attachmentDTO.FileName" title="Delete">
                                            <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>
                        <!--Attachment Item Template used by notedetail.js for the newly uploaded files-->
                        <template id="attachment-template">
                            <li class="rounded-box attachment flex w-full cursor-pointer items-center gap-3 p-2 transition-colors hover:bg-base-200">
                                <span data-icon="pdf" class="rounded-field grid size-9 shrink-0 place-items-center bg-gray-100 text-gray-600 dark:bg-red-500/15 dark:text-gray-400">
                                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
                                </span>
                                <span data-icon="image" class="rounded-field grid size-9 shrink-0 place-items-center bg-gray-100 text-gray-600 dark:bg-blue-500/15 dark:text-gray-400">
                                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path></svg>
                                </span>
                                <div class="flex min-w-0 flex-1 flex-col">
                                    <span data-field="name" class="truncate text-sm font-medium text-gray-800 dark:text-gray-200"></span>
                                    <span class="truncate text-xs text-gray-400">
                                        <span data-field="size"></span> ·
                                        <time class="timeago" data-field="created" datetime=""></time>
                                    </span>
                                </div>
                                <div class="flex shrink-0 gap-1 text-gray-400">
                                    <a href="" type="button" data-action="download" class="btn btn-ghost btn-xs btn-square" title="Download">
                                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg>
                                    </a>
                                    <button type="button" data-action="delete" class="btn btn-ghost btn-xs btn-square hover:text-error" title="Delete">
                                        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </li>
                        </template>
                        <!--Note Attachments Upload-->
                        <div class="mt-2">
                            <label for="file-dropzone" id="drop-zone" data-noteid="@Model.Id" class="card card-dash cursor-pointer bg-base-100 transition-colors hover:bg-base-200">
                                <span class="card-body items-center text-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="size-8 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 16V4m0 0-4 4m4-4 4 4M4 20h16" /></svg>
                                    <span class="text-sm">Add files</span>
                                    <span class="text-sm text-gray-400">
                                        PDF or Image
                                        <span class="text-sm opacity-70">Up to 10 files, 5 MB each</span>
                                    </span>
                                </span>
                                <input id="file-dropzone" type="file" accept=".pdf,.png,.jpg,.jpeg" multiple class="sr-only">
                            </label>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</div>

<!--Delete Dialog-->
<dialog id="delete_note_dialog" class="modal">
    <div class="modal-box">
        <h3 class="text-lg font-semibold">Delete this note?</h3>
        <p class="pt-2 text-sm text-gray-400">
            <span id="delete-note-title" class="font-semibold text-gray-500 dark:text-gray-300">@Model.Title</span> will be permanently deleted and its version history. This cannot be undone.
        </p>
        <div class="modal-action">
            <form method="dialog">
                <button class="btn">Close</button>
            </form>
            <form class="" asp-action="DeleteNote" asp-controller="Notes">
                <input value="@Model.Id" type="hidden" name="id" />
                <button type="submit" class="btn btn-error bg-red-500 text-white">Delete</button>
            </form>
        </div>
    </div>
</dialog>

<!--Delete Attachment Dialog-->
<dialog id="delete_attachment_dialog" class="modal">
    <div class="modal-box">
        <h3 class="text-lg font-semibold">Delete attachment?</h3>
        <p class="pt-2 text-sm text-gray-400">
            The file will be removed permanently.
        </p>
        <div class="modal-action">
            <form method="dialog">
                <button class="btn">Close</button>
            </form>
            <button type="button" id="confirm-delete-attachment" class="btn btn-error bg-red-500 text-white">
                <span class="loading loading-spinner loading-sm hidden"></span>
                Delete
            </button>
        </div>
    </div>
</dialog>

<!--View Attachment Dialog-->
<dialog id="view_attachment_dialog" class="modal">
    <div class="modal-box w-11/12 max-w-3xl p-4 sm:p-6">
        <!--Modal Close Button-->
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute top-2 right-2" aria-label="Close">✕</button>
        </form>
        <!--Modal Title-->
        <h3 class="truncate pr-8 text-base font-semibold sm:text-lg" id="attachment-dialog-title"></h3>
        <!--Modal Image-->
        <div class="rounded-box mt-4 grid min-h-48 place-items-center bg-base-200">
            <span id="attachment-dialog-loader" class="loading loading-spinner loading-lg text-gray-400"></span>
            <img id="attachment-dialog-image" class="rounded-box hidden max-h-[70dvh] w-full object-contain" alt="" />
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>


@section Scripts {
    <script src="~/lib/jquery-timeago/jquery.timeago.min.js" asp-append-version="true"></script>
    <script src="/js/notedetail.js" asp-append-version="true"></script>
}