@model List<NoteDTO>

<span id="total-notes" class="hidden">@ViewData["TotalNotes"]</span>
@*These is the partial View*@
@foreach (NoteDTO note in Model)
{
    <article class="min-h-40 rounded-lg border border-gray-200 p-4 hover:border-gray-400 dark:border-gray-700 hover:dark:border-gray-500">
        <a class="flex h-full cursor-pointer flex-col justify-between" asp-controller="Notes" asp-action="Index" asp-route-Id="@note.Id">
            <div class="flex flex-col gap-2">
                <h4 class="text-lg font-semibold">@note.Title</h4>
                <p class="line-clamp-3 text-sm text-stone-400">@(string.IsNullOrWhiteSpace(note.Description) ? "No content" : MarkdownRenderer.ConvertToPlainText(note.Description))</p>
            </div>
            <div class="space-y-1">
                <div class="mt-4">
                    <status-badge class="p-2" status="@note.Status" />
                </div>
                <div class="mt-3 w-full border-b border-gray-200 dark:border-gray-700">
                </div>
                <div class="my-1 flex flex-row items-center justify-between">
                    <div class="space-x-1">
                        <span class="inline-block size-2.5 rounded-[0.2em] bg-[@note.Category.Color]">
                        </span>
                        <span class="text-sm dark:text-gray-400">@note.Category.Name</span>
                    </div>
                    <div>
                        <time-ago date="@note.CreatedAt.DateTime" />
                    </div>
                </div>
            </div>
        </a>
    </article>
}
