@model List<NoteDTO>

<span id="search-notes-data" class="hidden" data-total-notes="@ViewData["TotalNotes"]" data-total-pages="@ViewData["TotalPages"]">@ViewData["TotalNotes"]</span>
@*These is the partial View*@
@foreach (NoteDTO note in Model)
{
    <article class="relative min-h-40 rounded-lg border border-gray-200 p-4 hover:border-gray-400 dark:border-gray-700 hover:dark:border-gray-500">
        <a class="flex h-full cursor-pointer flex-col justify-between" asp-controller="Notes" asp-action="Index" asp-route-Id="@note.Id">
            <div class="flex flex-col gap-2">
                <div class="pr-10">
                    <h4 class="text-lg font-semibold">@note.Title</h4>
                </div>
                <p class="line-clamp-3 text-sm text-stone-400">@(string.IsNullOrWhiteSpace(note.Description) ? "No content" : MarkdownRenderer.ConvertToPlainText(note.Description))</p>
            </div>
            <div class="space-y-1">
                <div class="mt-4">
                    <status-badge class="p-2" status="@note.Status" />
                </div>
                <div class="mt-3 w-full border-b border-gray-200 dark:border-gray-700">
                </div>
                <div class="my-1 flex flex-row items-center justify-between">
                    <div class="space-x-1">
                        <span class="bg-@note.Category.Color-500 inline-block size-2.5 rounded-[0.2em]">
                        </span>
                        <span class="text-sm dark:text-gray-400">@note.Category.Name</span>
                    </div>
                    <div>
                        <time-ago date="@note.UpdatedAt.HasValue ? note.UpdatedAt.Value.DateTime : note.CreatedAt.DateTime" />
                    </div>
                </div>
            </div>
        </a>
        <!--Notes Pin Button-->
        <button class="btn btn-ghost btn-sm pin-note absolute top-3 right-3 text-gray-500 dark:text-gray-300" data-noteId="@note.Id" data-pin="@note.Pinned" type="button" aria-label="@(note.Pinned ? "Unpin note" : "Pin note")">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3 @(note.Pinned ? "hidden" : "")" viewBox="0 0 16 16"><path fill="currentColor" d="M3 0h10v1c0 1.173-.294 2.075-.606 2.697a5 5 0 0 1-.394.656v2.175A6 6 0 0 1 14 11v1H9v3a1 1 0 1 1-2 0v-3H2v-1c0-1.778.774-3.375 2-4.472V4.353a5 5 0 0 1-.394-.656C3.294 3.075 3 2.173 3 1zm2.11 2c.076.332.183.6.284.803a2.7 2.7 0 0 0 .316.492l.006.006l.284.285v3.913l-.4.3A4 4 0 0 0 4.127 10h7.748A4 4 0 0 0 10.4 7.8l-.4-.3V3.585l.284-.284l.006-.007a2.7 2.7 0 0 0 .315-.492c.102-.204.209-.47.285-.803z" /></svg>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-black dark:text-gray-300 @(note.Pinned ? "" : "hidden")" viewBox="0 0 20 20"><path fill="currentColor" d="M11 12h6v-1l-3-1V2l3-1V0H3v1l3 1v8l-3 1v1h6v7l1 1l1-1v-7z" /></svg>
        </button>
    </article>
}
