@model List<NoteHistoryDTO>

@{
    ViewData["Title"] = "Version History";
    // Get the Id from the Url
    string noteId = Context.Request.RouteValues["id"]?.ToString() ?? string.Empty;
}

<div class="mx-auto max-w-7xl flex-1 px-4 py-8 md:px-8 md:py-10">
    <!--Page Header-->
    <div>
        <!--Back Button and Page Header-->
        <div class="flex items-center gap-3">
            <a asp-route="NoteDetails" asp-route-id="@noteId" class="btn btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 dark:text-gray-300" viewBox="0 0 1024 1024">
                    <path fill="currentColor" d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" />
                    <path fill="currentColor" d="m237.248 512l265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" />
                </svg>
            </a>
            <div class="flex flex-col gap-1">
                <h1 class="text-lg font-semibold">@(Model.FirstOrDefault()?.Title ?? "")</h1>
                <span class="inline-block text-gray-500">
                    @Model.Count versions | Newest first
                </span>
            </div>
        </div>
    </div>

</div>