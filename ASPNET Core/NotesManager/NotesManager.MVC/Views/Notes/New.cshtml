@model CreateNote

@{
    ViewData["Title"] = "New Note";
}

<div class="mx-auto max-w-7xl px-4 py-5 md:px-8 md:py-10">
    <!--Create Note Form using the tag Helper-->
    <form asp-action="New" asp-controller="Notes" method="post">
        <!--Back button and save button-->
        <div class="flex flex-row items-center justify-between">
            <!--Back Button-->
            <div class="flex flex-row items-center gap-2">
                <a asp-action="Index" asp-controller="Notes" class="btn btn-ghost btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-black dark:text-gray-300" viewBox="0 0 1024 1024"><path fill="currentColor" d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z" /><path fill="#000000" d="m237.248 512l265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z" /></svg>
                </a>
                <h4 class="inline-block text-lg font-semibold">
                    New Note
                </h4>
            </div>
            <!--Cancel and Save button-->
            <div class="space-x-2">
                <a class="btn btn-ghost btn-sm" asp-action="Index" asp-controller="Notes">
                    Cancel
                </a>
                <button class="btn btn-primary btn-sm px-5" type="submit" id="submit-btn">
                    Save
                </button>
            </div>
        </div>
        <!--form-->
        <div class="mt-8 space-y-5">
            <!--Title-->
            <div>
                <!--Input Tag Helper-->
                <input asp-for="Title" type="text" class="input input-lg w-full text-xl font-semibold" placeholder="Untitled note" />
                <span asp-validation-for="Title"></span>
            </div>
            <!--Status-->
            <div class="">
                <label class="label">
                    <span class="text-sm font-medium">Status</span>
                </label>
                <div class="mt-2 flex flex-wrap gap-3">
                    @foreach (NoteStatus status in Enum.GetValues<NoteStatus>())
                    {
                        (string label, string color) = CategoryConstants.StatusMapping[status];

                        <label class="flex cursor-pointer items-center gap-2 rounded-full border border-base-300 px-4 py-1.5 hover:bg-gray-200/50 has-checked:border-primary has-checked:bg-primary/5 dark:text-gray-400 dark:hover:bg-gray-900 has-checked:dark:text-gray-200">
                            <input type="radio" asp-for="Status" value="@status" checked="@(Model.Status == status)" class="hidden" />
                            <span class="size-3 rounded-full @color"></span>
                            <span>@label</span>
                        </label>
                    }
                </div>
            </div>
            <!--Category-->
            <div class="">
                <label class="label">
                    <span class="text-sm font-medium">Category</span>
                </label>
                <div class="mt-2 flex flex-wrap gap-3">
                    @foreach (CategoryDTO category in ViewBag.Categories)
                    {
                        <label class="flex cursor-pointer items-center gap-2 rounded-full border border-base-300 px-4 py-1.5 hover:bg-gray-200/50 has-checked:border-primary has-checked:bg-primary/5 dark:text-gray-400 dark:hover:bg-gray-900 has-checked:dark:text-gray-200">
                            <input type="radio" asp-for="CategoryId" value="@category.Id" checked="@(Model.CategoryId == category.Id)" class="hidden" />
                            <span class="size-3 rounded-full bg-[@category.Color]"></span>
                            <span>@category.Name</span>
                        </label>
                    }
                </div>
            </div>
            <!--Editor-->
            <textarea id="markdown-editor" class="" asp-for="Description"></textarea>
        </div>
    </form>
</div>

@section Scripts {
    <script src="/lib/markdown-text-editor/dist/markdown-text-editor.min.js" asp-append-version="true"></script>
    <script>
        $(function () {
            new MarkdownEditor('#markdown-editor');
        })
    </script>
}