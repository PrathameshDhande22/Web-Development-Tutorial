@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<div class="grid w-full flex-1 place-items-center px-4 py-16 md:px-8">
    <div class="w-full max-w-md space-y-1">
        <!--Page Header-->
        <h3 class="text-2xl font-semibold">Forgot your password?</h3>
        <p class="text-sm text-stone-400 dark:text-gray-300">Enter the email you signed up with and we'll send you a link to choose a new one.</p>
        <!--Reset Link Send-->
        <div class="mt-8 rounded-md bg-white p-6 shadow-md dark:bg-base-100">
            @if (!Model.ResetLinkSent)
            {
                <div class="flex gap-2">
                    <!--Mail Icon-->
                    <span class="rounded-full bg-gray-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3 text-primary" viewBox="0 0 32 32"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M29 9v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9m26 0a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2m26 0l-11.862 8.212a2 2 0 0 1-2.276 0L3 9" /></svg>
                    </span>
                    <div>
                        <h2>Check you email</h2>
                        <p>If an account exists for @Model.Email, a link to reset the password is on its way. It expires in one hour.</p>
                    </div>
                </div>
            }
            else
            {
                <!--Login Form-->
                <form asp-action="ForgotPassword" asp-controller="Auth" method="post" id="login-form" class="flex flex-col items-center gap-3">
                    <div class="form-input">
                        <label class="input-label" asp-for="Email">Email</label>
                        <input asp-for="Email" class="input w-full" type="text" />
                        <span asp-validation-for="Email" class="inline-block text-sm text-error"></span>
                    </div>
                    <!--Submit Form Button-->
                    <button class="btn btn-primary btn-block mb-0 w-full" type="submit">
                        Send reset link
                    </button>
                </form>
            }
        </div>
        <!--Not have an account-->
        <div class="mt-5 text-center text-sm text-gray-500">
            <span>Remembered it?</span>
            <a asp-action="Login" asp-controller="Auth" class="link font-semibold">Back to sign in</a>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial"></partial>
}