@model RegisterUser

@{
    ViewData["Title"] = "Create a free account";
}

<div class="grid w-full flex-1 place-items-center px-4 py-16 md:px-8">
    <div class="w-full max-w-md space-y-1">
        <!--Page header-->
        <h2 class="text-2xl font-semibold">Create your account</h2>
        <p class="text-sm text-stone-400 dark:text-gray-300">Keep notes and documents organised in one place</p>
        <!--Register Form-->
        <div class="mt-8 rounded-md bg-white p-6 shadow-md dark:bg-base-100">
            <form asp-action="Register" asp-controller="Auth" method="post" id="register-form" novalidate class="flex flex-col items-center gap-3">
                <div class="form-input">
                    <label class="input-label" asp-for="FullName">Full name</label>
                    <input asp-for="FullName" class="input w-full" type="text" />
                    <span asp-validation-for="FullName" class="inline-block text-sm text-error"></span>
                </div>
                <div class="form-input">
                    <label class="input-label" asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" class="input w-full" />
                    <span asp-validation-for="Email" class="inline-block text-sm text-error"></span>
                </div>
                <div class="form-input">
                    <label class="input-label" asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" class="input w-full" />
                    <!--Password Hints-->
                    <div class="mt-1 grid grid-cols-2 gap-2 text-sm text-gray-400" id="password-hints">
                        <span class="hint" id="character-hint">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 21 21"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m15.5 15.5l-10-10zm0-10l-10 10" /></svg>
                            <span>At least 8 characters</span>
                        </span>
                        <span class="hint" id="uppercase-hint">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 21 21"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m15.5 15.5l-10-10zm0-10l-10 10" /></svg>
                            <span>An uppercase letter</span>
                        </span>
                        <span class="hint" id="lowercase-hint">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 21 21"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m15.5 15.5l-10-10zm0-10l-10 10" /></svg>
                            <span>A lowercase letter</span>
                        </span>
                        <span class="hint" id="number-hint">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 21 21"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m15.5 15.5l-10-10zm0-10l-10 10" /></svg>
                            <span>A number</span>
                        </span>
                        <span class="hint" id="symbol-hint">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 21 21"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m15.5 15.5l-10-10zm0-10l-10 10" /></svg>
                            <span>A symbol</span>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="inline-block text-sm text-error"></span>
                </div>
                <div class="form-input">
                    <label class="input-label" asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" class="input w-full" />
                    <span asp-validation-for="ConfirmPassword" class="inline-block text-sm text-error"></span>
                </div>
                <!--Submit Form Button-->
                <button class="btn btn-primary btn-block mb-0 w-full" type="submit">
                    Create account
                </button>
            </form>
        </div>
        <!--Already Registered-->
        <div class="mt-5 text-center text-sm text-gray-500">
            <span>Already registered?</span>
            <a asp-action="Login" asp-controller="Auth" class="link font-semibold">Sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"></partial>
    <script src="~/js/register.js" asp-append-version="true"></script>
}