@model Notes

@{
    ViewData["Title"] = "Html Helpers";
    List<SelectListItem> categories = ViewBag.Categories as List<SelectListItem>;
}

<div class="mx-auto max-w-7xl space-y-3 px-4 py-6">
    <h2 class="text-lg font-bold">Html Helpers Tutorial</h2>
    <!--Html begin form Html helper-->
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "space-y-3" }))
    {
        <!--TextBox for Html helper-->
        @Html.TextBoxFor(notes => notes.Title, new { @class = "input input-md w-full", placeholder = "Enter the Title", id = "note-title-box" })
        <!--TextArea HTML Helper-->
        @Html.TextAreaFor(notes => notes.Description, new { @class = "textarea w-full", placeholder = "Enter the Content", id = "note-content-area" })
        <!--Drop down list HTML Helper-->
        @Html.LabelFor(notes => notes.CategoryId, "Select Category", new { @class = "label text-sm" })
        @Html.DropDownListFor(notes => notes.CategoryId, categories, new { @class = "select" })
        <!--RadionButton Html Helper-->
        <div class="flex flex-row flex-wrap gap-2 text-sm">
            @foreach (string status in Enum.GetNames<NoteStatus>())
            {
                @Html.Label(status, status, new { @class = "label" })
                @Html.RadioButtonFor(notes => notes.Status, status, new { @class = "radio radio-sm" })
            }
        </div>
        <div>
            <!--Checkbox Html Helper-->
            @Html.LabelFor(notes => notes.IsPinned, "Pin", new { @class = "label" })
            @Html.CheckBoxFor(notes => notes.IsPinned, new { @class = "checkbox" })
        </div>
        <div class="flex flex-col gap-1 text-sm">
            <!--Listbox html helper-->
            @Html.LabelFor(notes => notes.FilterCategoryId, "Filter by Category", new { @class = "label" })
            @Html.ListBoxFor(notes => notes.FilterCategoryId, categories, new { @class = "select" })
        </div>
        <!--Editor for Html Helper-->
        @Html.EditorFor(notes => notes.Createdat, "Created At", new { htmlAttributes = new { @class = "input" } })
        <!--Password Html Helper-->
        @Html.Password("Password", null, new { @class = "input" })
        <!--Hidden Html Helper-->
        @Html.HiddenFor(notes => notes.Id)
        <!--Custom Html Helper-->
        @Html.Status(NoteStatus.InProgress)
        <button type="submit" class="btn btn-sm btn-primary">Submit</button>
    }

    <!--route link Html helper-->
    @Html.RouteLink("Home Page", "Home", new { controller = "Home", action = "Index" })

    <!--Environment Tag helper-->
    <environment include="Development">
        <div>
            These is Development
        </div>
    </environment>
</div>