@{
    // Accessing the View data passed from the controller
    var features = ViewData["Features"] as List<Feature>;
    Layout = "_Layout";
}

<!--Section defining in the child view -->
@section Seo{
  <meta name="description" content="Notewell is a free, simple notes app for everyday life. Keep shopping lists, meal plans, trip checklists and budgets in one place, track what is done on a board, attach receipts and photos, and undo any change.">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <link rel="canonical" href="https://prathameshsystenics.github.io/notewell/">
  <link rel="alternate" hreflang="en" href="https://prathameshsystenics.github.io/notewell/">
  <link rel="alternate" hreflang="x-default" href="https://prathameshsystenics.github.io/notewell/">
  <meta name="author" content="Prathamesh">
  <meta name="keywords" content="notes app, to-do list, checklist app, shopping list, meal planner, packing list, budget planner, free notes app, online notebook">
}

<!--Hero Section-->
<section class="border-b border-gray-300/50 py-16 lg:py-24 dark:border-gray-800">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-4 md:px-8 lg:grid-cols-2">
        <!--Hero Text-->
        <div class="text-stone-800 dark:text-neutral-200">
            <div class="inline-flex items-center gap-2 rounded-full border border-stone-200 bg-base-100 px-3 py-1 text-sm dark:border-neutral-700">
                <span class="size-2 rounded-full bg-emerald-600"></span>
                <!--Accessing the View Data with Attribute -->
                @ViewData["About"]
            </div>

            <h1 class="mt-6 text-5xl font-bold tracking-tight sm:text-6xl">
                Your notes and documents,
                <span class="text-primary">in one tidy place.</span>
            </h1>

            <p class="text-xl/8 mt-6 max-w-xl text-stone-500 dark:text-neutral-400">
                Shopping lists, meal plans, trip checklists and household budgets, all in one place. Tick things off, see what is still to do at a glance, and keep receipts and photos with the note they belong to.
            </p>

            <!--Hero buttons-->
            <div class="mt-9 flex flex-wrap items-center gap-3">
                <a href="/Account/Register" class="btn btn-primary gap-2 rounded-md shadow-none">
                    Create a free account
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 32 32" fill="currentColor">
                        <path d="m18.72 6.78l-1.44 1.44L24.063 15H4v2h20.063l-6.782 6.78l1.44 1.44l8.5-8.5l.686-.72l-.687-.72l-8.5-8.5z" />
                    </svg>
                </a>
                <a href="/Account/Login" class="btn btn-outline rounded-md border-stone-200 shadow-none dark:border-neutral-700">
                    Sign in
                </a>
            </div>
        </div>

        <!--Hero Graphics-->
        <div class="relative pb-6 pl-6 lg:mt-20" aria-hidden="true">
            <!--Board window-->
            <div class="overflow-hidden rounded-lg border border-stone-200 bg-base-100 shadow-xl dark:border-neutral-700">
                <!--Window title bar-->
                <div class="flex items-center gap-5 border-b border-stone-200 bg-stone-50 px-4 py-3 dark:border-neutral-700 dark:bg-neutral-800">
                    <div class="flex gap-2">
                        <span class="size-2.5 rounded-full bg-stone-200 dark:bg-neutral-600"></span>
                        <span class="size-2.5 rounded-full bg-stone-200 dark:bg-neutral-600"></span>
                        <span class="size-2.5 rounded-full bg-stone-200 dark:bg-neutral-600"></span>
                    </div>
                    <span class="text-sm text-stone-400">My notes &middot; Board</span>
                </div>

                <!--Board columns-->
                <div class="grid grid-cols-3 gap-3 p-3.5 text-sm text-stone-800 dark:text-neutral-200">
                    <!--Draft-->
                    <div class="board-column">
                        <div class="board-column-title">
                            <span class="board-dot bg-stone-400"></span>
                            Draft
                        </div>
                        <div class="board-card">
                            <p class="font-medium">Birthday party ideas</p>
                            <div class="board-line mt-3 w-11/12"></div>
                            <div class="board-line w-3/4"></div>
                        </div>
                        <div class="board-card">
                            <p class="font-medium">Grocery list</p>
                            <div class="board-line mt-3 w-2/3"></div>
                        </div>
                    </div>

                    <!--In progress-->
                    <div class="board-column">
                        <div class="board-column-title">
                            <span class="board-dot bg-orange-500"></span>
                            In progress
                        </div>
                        <!--Highlighted card (the one that gets completed)-->
                        <div class="board-card border-blue-300 ring-2 ring-blue-100 dark:border-blue-500 dark:ring-blue-500/20">
                            <p class="font-medium">Weekend trip packing</p>
                            <ul class="board-meta flex-col items-start gap-0.5">
                                <li class="flex items-center gap-1">
                                    <!--Checkbox Logo-->
                                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="4" y="4" width="16" height="16" rx="2" />
                                        <path d="m8.5 12 2.5 2.5 4.5-5" />
                                    </svg>
                                    Phone charger
                                </li>
                                <li class="flex items-center gap-1">
                                    <!--Checkbox Logo-->
                                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="4" y="4" width="16" height="16" rx="2" />
                                    </svg>
                                    Sunscreen
                                </li>
                            </ul>
                        </div>
                        <div class="board-card">
                            <p class="font-medium">Weekly meal plan</p>
                            <div class="board-line mt-3 w-2/3"></div>
                        </div>
                    </div>

                    <!--Completed-->
                    <div class="board-column">
                        <div class="board-column-title">
                            <span class="board-dot bg-emerald-600"></span>
                            Completed
                        </div>
                        <div class="board-card">
                            <p class="font-medium">Monthly budget</p>
                            <p class="board-meta">
                                <!--Attach Pin Logo-->
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                                </svg>
                                2 receipts
                            </p>
                        </div>
                        <div class="board-card">
                            <p class="font-medium">Fix the kitchen tap</p>
                            <div class="board-line mt-3 w-1/2"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Notification toast overlapping the bottom-left corner-->
            <div class="absolute bottom-0 left-0 flex w-72 items-center gap-3 rounded-lg border border-stone-200 bg-base-100 p-4 text-sm text-stone-800 shadow-xl dark:border-neutral-700 dark:text-neutral-200">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-stone-100 text-stone-500 dark:bg-neutral-800">
                    <!--Bell Logo-->
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                    </svg>
                </span>
                <p>
                    Your note &ldquo;Weekend trip packing&rdquo; is now <span class="font-bold">Completed</span>.
                </p>
            </div>
        </div>
    </div>
</section>
<!--Features Section-->
<section id="features" class="border-b border-gray-300 py-10 lg:py-20 dark:border-gray-800">
    <div class="mx-auto max-w-7xl space-y-2.5 px-4 md:px-8">
        <span class="inline-block text-sm font-bold text-blue-500">Features</span>
        <h2 class="text-3xl font-extrabold">Everything a note needs, nothing it doesn't</h2>
        <p class="text-lg text-stone-500 dark:text-gray-400">A simple place for the lists, plans and papers of everyday life.</p>
        <div class="mt-9 grid grid-cols-2 gap-3 md:grid-cols-3">
            <!--Displaying all the features-->
            @foreach (Feature feature in features!)
            {
                <!--Rendering the Partial View using tag helper-->
                <partial name="_FeatureCard" model="feature"/>
            }
        </div>
    </div>
</section>
<!--Display Section-->
<section id="views" class="border-b border-gray-300 bg-[#f7f6f3] py-10 lg:py-20 dark:border-gray-800 dark:bg-[#202020]">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 md:px-8 lg:grid-cols-2">
        <!--Left Side-->
        <div class="space-y-2">
            <span class="inline-block text-sm font-bold text-blue-500">Three ways to see your notes</span>
            <h3 class="text-3xl font-extrabold">
                Grid, list or board. Switch with one click.
            </h3>
            <ul class="mt-7 space-y-5">
                <li class="flex gap-4">
                    <!--Icon-->
                    <span class="grid size-8 items-center rounded-lg bg-white p-2 dark:bg-base-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500" fill="currentColor" viewBox="0 0 1024 1024"><path d="M960 1024H640c-35.344 0-64-28.656-64-64V640c0-35.344 28.656-64 64-64h320c35.344 0 64 28.656 64 64v320c0 35.344-28.656 64-64 64zm0-384H640v320h320V640zm0-192H640c-35.344 0-64-28.656-64-64V64c0-35.344 28.656-64 64-64h320c35.344 0 64 28.656 64 64v320c0 35.344-28.656 64-64 64zm0-384H640v320h320V64zm-576 960H64c-35.344 0-64-28.656-64-64V640c0-35.344 28.656-64 64-64h320c35.344 0 64 28.656 64 64v320c0 35.344-28.656 64-64 64zm0-384H64v320h320V640zm0-192H64c-35.344 0-64-28.656-64-64V64C0 28.656 28.656 0 64 0h320c35.344 0 64 28.656 64 64v320c0 35.344-28.656 64-64 64zm0-384H64v320h320V64z" /></svg>
                    </span>
                    <div>
                        <div class="text-lg font-semibold">
                            Grid
                        </div>
                        <div class="text-[0.9em] text-stone-500 dark:text-gray-400">
                            Cards with a peek at each note, easy to scan.
                        </div>
                    </div>
                </li>
                <li class="flex gap-4">
                    <!--Icon-->
                    <span class="grid size-8 items-center rounded-lg bg-white p-2 dark:bg-base-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path d="M1 4h2v2H1V4zm4 0h14v2H5V4zM1 9h2v2H1V9zm4 0h14v2H5V9zm-4 5h2v2H1v-2zm4 0h14v2H5v-2z" /></svg>
                    </span>
                    <div>
                        <div class="text-lg font-semibold">
                            List
                        </div>
                        <div class="text-[0.9em] text-stone-500 dark:text-gray-400">
                            One note per line, with its category and status.
                        </div>
                    </div>
                </li>
                <li class="flex gap-4">
                    <!--Icon-->
                    <span class="grid size-8 items-center rounded-lg bg-white p-2 dark:bg-base-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500" viewBox="0 0 24 24"><path fill="currentColor" d="M2 4a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1zm14 15h4V5h-4zM14 5h-4v14h4zM4 5v14h4V5z" /></svg>
                    </span>
                    <div>
                        <div class="text-lg font-semibold">
                            Board
                        </div>
                        <div class="text-[0.9em] text-stone-500 dark:text-gray-400">
                            To do, doing, done. Drag a card to move it along.
                        </div>
                    </div>
                </li>
            </ul>
        </div>
        <!--Right Side-->
        <div class="p-6">
            <div class="rounded-xl bg-white p-5 sm:p-6 dark:bg-base-100">
                <div class="mb-4 flex flex-row justify-between text-sm text-stone-500 dark:text-gray-400">
                    <span class="inline-block">
                        Weekend trip packing
                    </span>
                    <span class="inline-block">
                        Write and preview side by side
                    </span>
                </div>
                <div class="grid sm:mt-0 sm:grid-cols-2">
                    <div class="bg-[#f7f6f3] p-3 dark:bg-[#202020]">
                        <pre class="text-sm/6 font-mono text-stone-700 dark:text-gray-300">
<span class="text-blue-500">## Packing list</span>
- [x] Phone charger
- [x] Tickets
- [ ] Sunscreen

Ask the neighbour to
**water the plants**.
                        </pre>
                    </div>
                    <div class="mt-4 px-4 sm:mt-0">
                        <h3 class="text-xl font-semibold">Packing List</h3>
                        <ul class="mt-2 space-y-2 text-lg font-light">
                            <li class="space-x-2">
                                <input type="checkbox" disabled checked />
                                <span>Phone charger</span>
                            </li>
                            <li class="space-x-2">
                                <input type="checkbox" disabled checked />
                                <span>
                                    Tickets
                                </span>
                            </li>
                            <li class="space-x-2">
                                <input type="checkbox" disabled />
                                <span>
                                    Sunscreen
                                </span>
                            </li>
                        </ul>
                        <p class="mt-4 text-lg">
                            Ask the neighbour to <b class="font-semibold">water the plants</b>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--FAQ Section-->
<section class="py-10 lg:py-20">
    <div class="mx-auto max-w-3xl space-y-2.5 px-4 md:px-8">
        <span class="inline-block text-sm font-bold text-blue-500">Questions</span>
        <h2 class="text-3xl font-extrabold">Frequently asked questions</h2>
        <div class="join join-vertical mt-5 w-full bg-base-100">
            <!--Displaying all the FAQ using the ViewBag-->
            @foreach (FAQItem fAQ in ViewBag.FAQs)
            {
                <!--Rendering the partial view using the method-->
               {
                    await Html.RenderPartialAsync("FAQ", fAQ);
               }
            }
        </div>
    </div>
</section>
<!--CTA Section -->
<section class="pb-20">
    <div class="mx-auto flex max-w-7xl flex-row items-center justify-between gap-7 rounded-xl border border-gray-300 bg-[#f7f6f3] px-8 py-16 md:px-12 dark:border-gray-800 dark:bg-[#202020]">
        <div class="space-y-2">
            <h2 class="text-3xl font-bold">
                Start organising your notes today
            </h2>
            <p class="text-stone-500 text-[1.1em] dark:text-gray-400">
                Create an account in seconds. Sample data is ready if you want to look around first.
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="/Account/Register" class="btn btn-primary">Get started</a>
            <a href="/Account/Login" class="btn btn-ghost hairline border bg-base-100">Try the demo</a>
        </div>
    </div>
</section>