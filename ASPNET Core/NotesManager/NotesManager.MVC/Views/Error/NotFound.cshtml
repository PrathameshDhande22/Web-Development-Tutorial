@{
    ViewData["Title"] = "Page Not Found";
}

<!--Not Found Page-->
<div class="full-page grid place-items-center bg-[#f7f6f3] px-4 py-10 md:px-8 dark:bg-base-200">
    <div class="flex flex-col items-center gap-2">
        <p class="font-mono text-gray-500">404</p>
        <h1 class="text-xl font-semibold">We couldn't find that page</h1>
        <p class="text-sm text-gray-500">The link may be broken, or the page may have moved</p>
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary btn-sm mt-2 rounded-md">Go to Home</a>
    </div>
</div>
