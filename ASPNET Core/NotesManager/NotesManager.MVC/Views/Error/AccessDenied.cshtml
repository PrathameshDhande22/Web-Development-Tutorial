@{
    ViewData["Title"] = "Access denied";
}

<!--Access Denied Page-->
<div class="full-page grid place-items-center bg-[#f7f6f3] px-4 py-10 md:px-8 dark:bg-base-200">
    <div class="flex flex-col items-center gap-2">
        <p class="font-mono text-gray-500">403</p>
        <h1 class="text-xl font-semibold">You don't have access to this page</h1>
        <p class="text-sm text-gray-500">Your account does not have the role this page requires</p>
        <div class="mt-2 flex gap-2">
            <a asp-action="Index" asp-controller="Home" class="btn btn-primary btn-sm rounded-md">Go to my home page</a>
            <a asp-action="Login" asp-controller="Auth" class="btn btn-ghost btn-sm rounded-md">Sign in as someone else</a>
        </div>
    </div>
</div>
